---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Lobsters Daily">
  <main class="text-center py-16">
    <p class="text-6xl mb-4">🦞</p>
    <h1 class="text-2xl font-bold mb-2">Page not found</h1>
    <p class="text-lobster-muted mb-6">
      That page doesn't exist — maybe the digest you're after is in the archive.
    </p>
    <a href="/" class="text-lobster-accent no-underline hover:underline">← Back to the latest digest</a>
  </main>
</Base>
