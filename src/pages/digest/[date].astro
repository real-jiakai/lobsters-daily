---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArchiveNav from '../../components/ArchiveNav.astro';
import MobileDrawer from '../../components/MobileDrawer.astro';

export async function getStaticPaths() {
  const digests = await getCollection('digests');
  return digests.map((digest) => ({
    params: { date: digest.data.date },
    props: { digest },
  }));
}

const { digest } = Astro.props;
const { data } = digest;

const allDigests = (await getCollection('digests')).sort(
  (a, b) => b.data.date.localeCompare(a.data.date)
);
---

<Base title={data.title}>
  <button slot="header-extra" id="drawer-toggle" class="lg:hidden p-2 -ml-2 text-lobster-muted hover:text-lobster-text" aria-label="Open navigation">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>

  <MobileDrawer digests={allDigests} currentDate={data.date} />

  <div class="lg:flex lg:gap-6">
    <ArchiveNav digests={allDigests} currentDate={data.date} />

    {/* ── Main Content ── */}
    <main class="flex-1 min-w-0">
      <a href="/" class="text-lobster-muted text-sm no-underline hover:text-lobster-accent mb-4 inline-block">← Back to latest</a>

      <h1 class="text-2xl font-bold mb-6">{data.title}</h1>

      <ul class="space-y-3 list-disc pl-5 marker:text-lobster-accent">
        {data.items.map((item) => (
          <li>
            <a
              href={item.url}
              target="_blank"
              rel="noopener"
              class="text-base font-medium text-lobster-text no-underline hover:text-lobster-accent"
            >
              {item.title}
            </a>
            <div class="mt-0.5">
              <a
                href={item.lobsters_url}
                target="_blank"
                rel="noopener"
                class="text-xs text-lobster-muted hover:text-lobster-accent no-underline"
              >
                (comments)
              </a>
            </div>
          </li>
        ))}
      </ul>
    </main>
  </div>
</Base>
